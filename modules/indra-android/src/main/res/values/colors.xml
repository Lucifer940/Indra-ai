<?xml version="1.0" encoding="utf-8"?>
<!--
  INDRA AI brand palette.
  Premium light surface with holographic accents: crimson red (primary), hot pink,
  violet and electric blue. Dark values live in values-night/colors.xml and are
  applied at runtime by UiKit when the user picks the dark theme.
-->
<resources>
    <!-- Light theme (default) -->
    <color name="indra_bg">#F6F7FC</color>
    <color name="indra_surface">#FFFFFF</color>
    <color name="indra_surface_high">#FFF3F6</color>
    <color name="indra_accent">#FF2B4E</color>
    <color name="indra_accent_soft">#FFE3EA</color>
    <color name="indra_secondary">#7C4DFF</color>
    <color name="indra_pink">#FF4D8D</color>
    <color name="indra_blue">#2F80ED</color>
    <color name="indra_text">#14142B</color>
    <color name="indra_text_dim">#6E7191</color>
    <color name="indra_stroke">#F0DCE3</color>
    <color name="indra_success">#12B76A</color>
    <color name="indra_warning">#F79009</color>
    <color name="indra_error">#E01E37</color>
    <color name="indra_icon_bg">#12000A</color>

    <!-- Gradients (drawables use these) -->
    <color name="grad_start">#FF2B4E</color>
    <color name="grad_mid">#FF4D8D</color>
    <color name="grad_end">#7C4DFF</color>
</resources>
