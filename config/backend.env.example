# ==========================================================================
# INDRA AI backend configuration - copy to config/backend.env and edit.
# NEVER commit the real file (it is git-ignored).
# ==========================================================================

# --- Server -------------------------------------------------------------
INDRA_PORT=8420
INDRA_BIND=0.0.0.0
INDRA_PUBLIC_URL=http://127.0.0.1:8420
INDRA_DATA_DIR=./data
INDRA_DEBUG=false

# --- Security (generate with: openssl rand -base64 48) ------------------
# Leave empty on first run: the server generates and stores them with 0600 perms.
INDRA_JWT_SECRET=
# Master key that encrypts users' AI API keys at rest.
INDRA_MASTER_KEY=

# --- Database (optional; omit for the built-in JSON file store) ---------
# INDRA_DB_URL=jdbc:sqlite:./data/indra.db
# INDRA_DB_URL=jdbc:postgresql://127.0.0.1:5432/indra
# INDRA_DB_USER=indra
# INDRA_DB_PASSWORD=change-me

# --- Administrator bootstrap (used once, then remove) -------------------
INDRA_ADMIN_EMAIL=owner@example.com
INDRA_ADMIN_PASSWORD=ChangeThisNow123

# --- HTTP rate limits (requests per minute) -----------------------------
INDRA_RATE_LIMIT=120
INDRA_AUTH_RATE_LIMIT=20
# Comma separated origins for browser clients, or * for the desktop app default.
INDRA_CORS_ORIGINS=*

# --- AI providers -------------------------------------------------------
# Server keys are optional. Users can also add their own keys in the app.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
GITHUB_MODELS_TOKEN=
GOOGLE_AI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# --- Search and news ----------------------------------------------------
# Optional. Without it, Wikipedia is used for search (no news).
TAVILY_API_KEY=

# --- Google sign-in (OAuth 2.0 web client) ------------------------------
# Authorised redirect URI must match the app, e.g.
#   https://your-server/api/v1/auth/oauth/google/callback  (or the app scheme)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- GitHub sign-in (OAuth app) ----------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- TLS (optional, strongly recommended in production) -----------------
# INDRA_TLS_KEYSTORE=/etc/indra/keystore.p12
# INDRA_TLS_PASSWORD=change-me

# Run as an on-device engine (used by the Android app: loopback bind, OS-assigned
# port, device-session endpoint enabled). Leave unset for a normal server.
# INDRA_LOCAL_MODE=true
